# Copy this file to .env and adjust the values.
# Variables exposed to the front-end need the VITE_ prefix.

# Base URL (origin) of the back-end API, without the /api prefix:
# the routes in the OpenAPI contract already include it.
# It is read by the browser, so it must be reachable from the user's machine.
VITE_API_URL=http://localhost:3000

# --- Docker Compose only (optional) ---
# Port where the front-end is published. The back-end allows http://localhost:5173 by default.
# WEB_PORT=5173

# Real Google sign-in. Without these, the demo placeholders are used.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Port of the emulated S3 (MiniStack). Change it if 4566 is already in use on your machine.
# MINISTACK_PORT=4566
